#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_BRANCH="${SWARMFORGE_SCRIPTS_BRANCH:-main}"
ARCHIVE_URL="${SWARMFORGE_SCRIPTS_URL:-https://github.com/unclebob/swarm-forge/archive/refs/heads/${MAIN_BRANCH}.tar.gz}"
TMP_DIR=""
LOCAL_TOOLS="${SWARMFORGE_LOCAL_TOOLS:-$HOME/.local/swarmforge-tools}"

if [[ -d "$LOCAL_TOOLS/usr/bin" ]]; then
  export PATH="$SCRIPT_DIR/swarmforge:$HOME/.opencode/bin:$LOCAL_TOOLS/usr/bin:$PATH"
  export LD_LIBRARY_PATH="$LOCAL_TOOLS/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
else
  export PATH="$SCRIPT_DIR/swarmforge:$HOME/.opencode/bin:$PATH"
fi

cleanup() {
  if [[ -n "$TMP_DIR" ]]; then
    rm -rf "$TMP_DIR"
  fi
}
trap cleanup EXIT

if [[ ! -d "$SCRIPT_DIR/swarmforge/scripts" || ! -d "$SCRIPT_DIR/swarmforge/scripts/shared-articles" ]]; then
  TMP_DIR="$(mktemp -d)"
  mkdir -p "$SCRIPT_DIR/swarmforge"
  curl -L "$ARCHIVE_URL" | tar -xz --strip-components=1 -C "$TMP_DIR"
  if [[ ! -d "$SCRIPT_DIR/swarmforge/scripts" ]]; then
    cp -R "$TMP_DIR/swarmforge/scripts" "$SCRIPT_DIR/swarmforge/scripts"
  fi
  if [[ -d "$TMP_DIR/swarmforge/constitution/articles" ]]; then
    mkdir -p "$SCRIPT_DIR/swarmforge/scripts/shared-articles"
    cp -R "$TMP_DIR/swarmforge/constitution/articles/." "$SCRIPT_DIR/swarmforge/scripts/shared-articles/"
  fi
fi

PATCH_FILE="$SCRIPT_DIR/.okf/swarmforge/patches/generic-agent-adapter.patch"
if [[ -f "$PATCH_FILE" && -f "$SCRIPT_DIR/swarmforge/scripts/swarmforge.bb" ]]; then
  if ! grep -q '"adapter"' "$SCRIPT_DIR/swarmforge/scripts/swarmforge.bb"; then
    command -v patch >/dev/null 2>&1 || {
      echo "The generic Swarm Forge adapter requires the patch command." >&2
      exit 1
    }
    patch --batch --forward --silent -p0 < "$PATCH_FILE"
  fi
fi

SHELL_PATCH_FILE="$SCRIPT_DIR/.okf/swarmforge/patches/bash-shell-cleanup.patch"
if [[ -f "$SHELL_PATCH_FILE" && -f "$SCRIPT_DIR/swarmforge/scripts/swarmforge.bb" ]]; then
  if grep -q '&!; exit' "$SCRIPT_DIR/swarmforge/scripts/swarmforge.bb"; then
    patch --batch --forward --silent -p0 < "$SHELL_PATCH_FILE"
  fi
fi

export SWARMFORGE_AGENT_ADAPTER="${SWARMFORGE_AGENT_ADAPTER:-$SCRIPT_DIR/.okf/swarmforge/adapters/opencode2}"

exec "$SCRIPT_DIR/swarmforge/scripts/swarmforge.sh" "$@"
